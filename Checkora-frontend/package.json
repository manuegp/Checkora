{
  "name": "checkora-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:production": "node scripts/generate-production-environment.mjs && ng build --configuration production",
    "vercel-build": "npm run build:production"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@jsverse/transloco": "^8.4.0",
    "@neondatabase/auth": "^0.5.0-beta",
    "@taiga-ui/addon-mobile": "^5.22.0",
    "@taiga-ui/core": "^5.22.0",
    "@taiga-ui/icons": "^5.22.0",
    "@taiga-ui/kit": "^5.22.0",
    "@taiga-ui/layout": "^5.22.0",
    "@taiga-ui/styles": "^5.22.0",
    "jose": "^6.2.10",
    "rxjs": "~7.8.0",
    "taiga-ui": "^5.22.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.3",
    "@angular/cli": "^21.0.3",
    "@angular/compiler-cli": "^21.0.0",
    "jsdom": "^27.1.0",
    "less": "^4.9.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
