DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
NEON_AUTH_URL=https://tu-endpoint-de-neon-auth/neondb/auth
NEON_AUTH_JWKS_URL=https://tu-endpoint-de-neon-auth/.well-known/jwks.json
PORT=3000
FRONTEND_ORIGIN=http://localhost:4200

# Correo transaccional (Resend). No compartas la API key con el frontend.
RESEND_API_KEY=
# Ejemplo, tras verificar el dominio en Resend: Checkora <noreply@checkora.es>
EMAIL_FROM=
# Opcional: dirección que recibirá las respuestas de los destinatarios.
EMAIL_REPLY_TO=
